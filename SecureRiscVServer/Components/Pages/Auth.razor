@page "/auth"

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<h1>You are authenticated</h1>

<AuthorizeView>
    <p>Hello @context.User.Identity?.Name!</p>
</AuthorizeView>

<hr />

<h3>Send RISC-V Instructions</h3>

<textarea @bind="instructionText"
          rows="6"
          cols="40"
          placeholder="One instruction per line, e.g.&#10;0x003100B3">
</textarea>

<br />
<br />

<button @onclick="SendInstructions">
    Send instructions
</button>

<p style="color: green">@status</p>

@code {
    private string instructionText = "";
    private string status = "";

    private async Task SendInstructions()
    {
        var instructions = instructionText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        var payload = new
        {
            instructions = instructions
        };

        var response = await Http.PostAsJsonAsync(
            "/api/crypto/instructions",
            payload
        );

        if (response.IsSuccessStatusCode)
        {
            status = "✅ Instructions sent successfully.";
            instructionText = "";
        }
        else
        {
            status = "❌ Failed to send instructions.";
        }
    }
}
