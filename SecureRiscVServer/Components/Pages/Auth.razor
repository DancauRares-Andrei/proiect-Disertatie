@page "/auth"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<script>
async function sendInstructions() {
    const textarea = document.getElementById('instr');
    const statusEl = document.getElementById('status');

    const instructions = textarea.value
        .split('\n')
        .map(s => s.trim())
        .filter(s => s.length > 0);

    if (instructions.length === 0) {
        statusEl.textContent = "❌ Please enter at least one instruction.";
        return;
    }

    try {
        const response = await fetch("/api/crypto/instructions", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ instructions: instructions })
        });

        if (response.ok) {
            statusEl.textContent = "✅ Instructions sent successfully.";
            textarea.value = "";
        } else {
            const text = await response.text();
            statusEl.textContent = `❌ Failed to send instructions: ${text}`;
        }
    } catch (err) {
        statusEl.textContent = "❌ Error sending instructions: " + err;
    }
}
</script>

<PageTitle>Auth</PageTitle>

<h1>You are authenticated</h1>

<AuthorizeView>
    <p>Hello @context.User.Identity?.Name!</p>
</AuthorizeView>

<hr />

<h3>Send RISC-V Instructions</h3>

<textarea id="instr" rows="6" cols="40"
          placeholder="One instruction per line, e.g.&#10;0x003100B3"></textarea>
<br><br>
<button onclick="sendInstructions()">Send instructions</button>
<p id="status" style="color: green"></p>


