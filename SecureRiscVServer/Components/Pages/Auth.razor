@page "/riscv"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<PageTitle>RISC-V</PageTitle>
<script src="riscv.js"></script>
<h3>Send full RISC-V program</h3>

<textarea id="instr"
          rows="10"
          cols="50"
          placeholder="O instructiune pe linie.
Exemplu:
addi a0, zero, 5">
</textarea>

<br /><br />

<button onclick="sendInstructions()">
    Send program
</button>

<p id="status" style="color: green"></p>

